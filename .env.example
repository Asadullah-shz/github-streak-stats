# Your GitHub Personal Access Tokens (Comma separated for token pooling)
# Get a token at: https://github.com/settings/tokens (No special scopes required for public profiles)
GITHUB_TOKEN=ghp_token1,ghp_token2

# Upstash Redis for Edge Caching
# Create a free database at: https://upstash.com/
UPSTASH_REDIS_REST_URL=https://your-database-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
